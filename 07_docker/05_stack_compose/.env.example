# Copier ce fichier en `.env` (jamais versionné) avant de démarrer la stack :
#   cp .env.example .env
#
# Compose lit automatiquement le `.env` situé à côté du docker-compose.yml
# et remplace les ${VARIABLES} qui y figurent.

API_PORT=3000

# Port de la base côté hôte (uniquement pour se connecter avec un client local)
DB_PORT_HOST=5433

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=app
